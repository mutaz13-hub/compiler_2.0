<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>{{ product.name }} - {{ site_title }}</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <header>
        <h1>{{ site_title }}</h1>
        <nav>
            <a href="index.html">Home</a>
            <a href="add_product.html">Add Product</a>
        </nav>
    </header>

    <main class="detail">
        <img src="{{ product.image }}" alt="{{ product.name }}" />
        <h2>{{ product.name }}</h2>
        <p class="price">${{ product.price }}</p>
        <div class="actions">
            <a href="edit_{{ product.id }}.html" class="btn secondary">Edit</a>
            <a href="delete_{{ product.id }}.html" class="btn danger">Delete</a>
            <a href="index.html" class="btn">Back to list</a>
        </div>
    </main>
</body>
</html>
